# Reel Radar needs one free credential from TMDB (themoviedb.org).
# Create an account -> Settings -> API -> request a key (instant, free for non-commercial use).
#
# Provide EITHER the v4 "API Read Access Token" (recommended)...
TMDB_ACCESS_TOKEN=

# ...OR the older v3 "API Key". If both are set, the access token wins.
TMDB_API_KEY=

# Optional: default region used before a visitor picks one (ISO 3166-1 alpha-2).
NEXT_PUBLIC_DEFAULT_REGION=GB
